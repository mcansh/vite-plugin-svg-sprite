{
  "name": "@mcansh/vite-plugin-svg-sprite",
  "version": "0.7.2",
  "description": "Vite plugin that combines imported SVGs into a single optimized sprite sheet, with each import resolving to a <use href>-ready symbol URL.",
  "keywords": [
    "icons",
    "sprite",
    "svg",
    "svg-sprite",
    "vite",
    "vite-plugin"
  ],
  "license": "MIT",
  "author": "Logan McAnsh <logan@mcan.sh> (https://mcan.sh)",
  "repository": {
    "url": "mcansh/vite-plugin-svg-sprite",
    "directory": "packages/vite-plugin-svg-sprite"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/mcansh"
    }
  ],
  "files": [
    "client.d.ts",
    "dist",
    "package.json",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsc --watch",
    "test": "node --import ./register-node-tsx.js --test src/index.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "fs-extra": "^11.4.1",
    "svgo": "^4.1.0",
    "svgstore": "^3.0.1"
  },
  "devDependencies": {
    "@remix-run/node-tsx": "^1.0.0",
    "@types/fs-extra": "^11.0.4",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "vite": "^5.0.0-0 || ^6.0.0-0 || ^7.0.0-0 || ^8.0.0-0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
