{
  "name": "remix-pitlane",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#app/*": "./app/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
