  },
  "devDependencies": {
    "@mcansh/vite-plugin-svg-sprite": "workspace:*",
    "@types/node": "^24.19.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=24.3.0"
  }
}
